# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Internal planning docs and the original build spec (not part of the product)
docs/
batwa-app-spec.md

# Build output (npm run build) and installed tooling
dist/
node_modules/

# Stray package manifests. Batwa has no runtime dependencies; the only npm
# projects are the root (Vite, dev only), the relay and tools/, allowed below.
package.json
package-lock.json
pnpm-lock.yaml
yarn.lock

# ...except the root build: Vite as a devDependency, lockfile committed so
# `npm ci` on Vercel installs exactly what was tested.
!/package.json
!/package-lock.json

# ...except the relay Worker, which is a separate deployable with its own
# toolchain (wrangler as a devDependency). Its node_modules stays ignored.
!relay/package.json
!relay/package-lock.json
relay/.wrangler/

# ...and the dev-only image tool (tools/make-images.mjs). Never loaded by the app.
!tools/package.json

# Local scratch
*.log
tmp/
.tmp/

# Portfolio intake output — copied into the zubyr.dev repo by hand.
zubyr-export/
